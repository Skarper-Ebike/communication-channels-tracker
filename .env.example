# Copy to .local/.env and fill in (or let `setup` write it for you).
# Never commit real values anywhere. chmod 600 this file.

# Claude classification (optional — without it, briefings are deterministic-only)
ANTHROPIC_API_KEY=

# Jira connector
JIRA_EMAIL=
JIRA_API_TOKEN=

# Slack delivery: incoming webhook for YOUR private channel
WORK_AGENT_SLACK_WEBHOOK=

# Slack input: user token (xoxp-…) with channels:history, groups:history, users:read
SLACK_USER_TOKEN=

# Google Drive: OAuth Desktop-app client (console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Basecamp: app credentials (launchpad.37signals.com/integrations)
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
